---
import { site } from '../config/site';

export interface Crumb {
  label: string;
  href: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const all = [{ label: 'Beranda', href: '/' }, ...items];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: all.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: new URL(c.href, site.url).href,
  })),
};
---

<nav aria-label="Breadcrumb" class="crumbs">
  <ol>
    {
      all.map((c, i) => (
        <li>
          {i < all.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
        </li>
      ))
    }
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  .crumbs ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0;
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 0.25rem;
    opacity: 0.6;
  }

  .crumbs a {
    text-decoration: none;
  }

  .crumbs a:hover {
    text-decoration: underline;
  }
</style>
