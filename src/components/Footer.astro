---
import { site } from '../config/site';
import { getCollection } from 'astro:content';
import { getLocale, paths, t } from '../i18n';

const locale = getLocale(Astro.url);
const areas = (await getCollection('area')).sort((a, b) => a.data.order - b.data.order);
const ui = t(locale);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__areas">
    <span>{ui.serviceArea}:</span>
    {areas.map((a) => <a href={`/${a.data.slug}/`}>Souvenir {a.data.area}</a>)}
  </div>
  <small>&copy; {year} {site.name} · {ui.hoursLabel}: {ui.hours}</small>
  <nav aria-label={ui.navFooter}>
    <a href={paths.catalog(locale)}>{ui.catalog}</a>
    <a href={paths.howTo(locale)}>{ui.howTo}</a>
    <a href={paths.blog(locale)}>{ui.blog}</a>
    <a href={site.social.instagram} target="_blank" rel="noopener">Instagram {site.social.instagramHandle}</a>
  </nav>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding: 20px var(--gutter);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }

  .footer__areas {
    flex-basis: 100%;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .footer a {
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--text);
  }
</style>
