---
import { site } from '../config/site';
import { whatsappLink } from '../lib/products';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div>
      <p class="footer__brand">{site.name}</p>
      <p class="footer__text">{site.description}</p>
    </div>
    <nav aria-label="Navigasi footer" class="footer__links">
      <a href="/produk/mug/">Mug Custom</a>
      <a href="/produk/tumbler/">Tumbler Custom</a>
      <a href="/#cara-pesan">Cara Pesan</a>
      <a href={whatsappLink()} target="_blank" rel="noopener">WhatsApp</a>
      {site.social.instagram && <a href={site.social.instagram} target="_blank" rel="noopener">Instagram</a>}
    </nav>
  </div>
  <div class="container footer__bottom">
    <small>&copy; {year} {site.name} · papinkagaleria.com</small>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: 48px 24px;
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem;
  }

  .footer__brand {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .footer__text {
    max-width: 52ch;
    color: var(--muted);
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 600;
  }

  .footer__links a {
    text-decoration: none;
    color: var(--muted);
  }

  .footer__links a:hover {
    color: var(--accent);
  }

  .footer__bottom {
    border-top: 1px solid var(--line);
    margin-top: 2rem;
    padding-top: 1.25rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
