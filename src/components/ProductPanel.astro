---
import Icon from './Icon.astro';
import { getLocale, t } from '../i18n';
import { PANEL_IMAGE_SIZE, panelData, type Product } from '../lib/products';

interface Props {
  product: Product;
  /** Tampilkan tombol sebelumnya/berikutnya (beranda). */
  interactive?: boolean;
  /** Jika diisi, tombol X tampil dan mengarah ke URL ini. */
  closeHref?: string;
  /** Halaman detail sudah punya judul sendiri, jadi judul & deskripsi panel bisa disembunyikan. */
  showTitle?: boolean;
  showDescription?: boolean;
}

const { product, interactive = false, closeHref, showTitle = true, showDescription = true } = Astro.props;
const locale = getLocale(Astro.url);
const ui = t(locale);
const d = await panelData(product, locale);
---

<aside class:list={['panel', { 'panel--compact': !showTitle }]} data-panel aria-label={ui.productDetail}>
  {
    closeHref && (
      <a href={closeHref} class="panel__close" aria-label={ui.backToCatalog}>
        <Icon name="close" />
      </a>
    )
  }

  <div class="panel__stage">
    <div class="panel__img">
      <img data-p="img" src={d.img} alt={d.alt} width={PANEL_IMAGE_SIZE} height={PANEL_IMAGE_SIZE} />
    </div>
    {
      interactive && (
        <div class="panel__nav">
          <button type="button" data-p="prev" aria-label={ui.prev}>
            <Icon name="prev" size={14} />
          </button>
          <button type="button" data-p="next" aria-label={ui.next}>
            <Icon name="next" size={14} />
          </button>
        </div>
      )
    }
  </div>

  {
    showTitle && (
      <h2 class="panel__title">
        <span data-p="name">{d.name}</span> <small data-p="code">({d.code})</small>
      </h2>
    )
  }

  <ul class="features">
    <li>
      <span class="features__icon"><Icon name="ruler" /></span>
      <span data-p="size">{d.size}</span>
    </li>
    <li>
      <span class="features__icon"><Icon name="sparkle" /></span>
      <span data-p="feature">{d.feature}</span>
    </li>
    <li>
      <span class="features__icon"><Icon name="tag" /></span>
      <span data-p="category">{d.category}</span>
    </li>
  </ul>

  {
    showDescription && (
      <p class="panel__desc">
        <span data-p="desc">{d.desc}</span>{' '}
        <a href={d.url} data-p="url">
          {ui.readMore}
        </a>
      </p>
    )
  }

  <a href={d.wa} data-p="wa" class="order" target="_blank" rel="noopener">
    <span class="order__icon"><Icon name="bag" size={16} /></span>
    <span class="order__label">{ui.orderLabel}</span>
    <span class:list={['order__price', { 'price-ask': !product.data.price }]} data-p="price">{d.price}</span>
  </a>
</aside>

<style>
  .panel {
    position: relative;
    background: var(--panel);
    color: var(--panel-ink);
    padding: clamp(20px, 3vw, 36px);
    display: flex;
    flex-direction: column;
  }

  .panel__close {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--panel-ink);
  }

  .panel__close:hover {
    background: rgb(0 0 0 / 0.08);
  }

  .panel__stage {
    position: relative;
    padding: 12px 8% 34px;
    margin-bottom: 1.25rem;
  }

  .panel__img {
    position: relative;
    z-index: 1;
    aspect-ratio: 1;
    max-width: 340px;
    margin-inline: auto;
    border-radius: 22px;
    overflow: hidden;
  }

  .panel__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  .panel__nav {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    background: var(--panel-ink);
  }

  .panel__nav button {
    display: grid;
    place-items: center;
    width: 28px;
    height: 22px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }

  .panel__nav button:hover {
    background: rgb(255 255 255 / 0.15);
  }

  .panel__title {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.5vw, 1.6rem);
    font-weight: 600;
    line-height: 1.3;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }

  .panel__title small {
    font-size: 0.62em;
    font-weight: 400;
    white-space: nowrap;
    color: var(--panel-muted);
  }

  .features {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    text-align: center;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .features li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .features__icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: var(--panel-tile);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.08);
  }

  .panel__desc {
    font-size: 0.85rem;
    color: var(--panel-muted);
    margin-bottom: 1.25rem;
  }

  .panel__desc a {
    color: var(--panel-ink);
    font-weight: 500;
  }

  .order {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 8px 20px 8px 8px;
    border-radius: 999px;
    background: var(--panel-ink);
    color: #fff;
    text-decoration: none;
    font-family: var(--font-display);
    transition: transform 0.15s;
  }

  .order:hover {
    transform: translateY(-1px);
  }

  .order__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #fff;
    color: var(--panel-ink);
    flex-shrink: 0;
  }

  .order__label {
    flex: 1;
    font-weight: 500;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .order__price {
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--accent);
    white-space: nowrap;
  }

  /* Layar lebar: panel di samping konten, setinggi layar sampai ke atas, tetap terlihat saat scroll */
  @media (min-width: 1100px) {
    .panel {
      position: sticky;
      top: 0;
      align-self: start;
      height: 100vh;
      margin-top: calc(-1 * var(--topbar-h));
      padding: calc(var(--topbar-h) + 24px) clamp(28px, 3.2vw, 56px) clamp(24px, 3vh, 40px);
      overflow-y: auto;
      scrollbar-width: none;
    }

    .panel__close {
      top: calc(var(--topbar-h) + 4px);
    }

    /* Isi panel di tengah secara vertikal, bar pesan tetap di bawah (margin-top: auto pada .order) */
    .panel__stage {
      margin-top: auto;
    }

    .panel__img {
      max-width: min(440px, 42vh);
    }

    .order {
      margin-top: clamp(24px, 4vh, 48px);
    }

    .panel > :nth-last-child(2) {
      margin-bottom: auto;
    }

    /* Halaman detail (tanpa judul & deskripsi): foto lebih besar */
    .panel--compact .panel__img {
      max-width: min(500px, 52vh);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .order {
      transition: none;
    }
  }
</style>
