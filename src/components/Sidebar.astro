---
import Icon, { type IconName } from './Icon.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { whatsappLink } from '../lib/products';

const nav: { href: string; label: string; icon: IconName }[] = [
  { href: '/', label: 'Beranda', icon: 'home' },
  { href: '/produk/', label: 'Katalog', icon: 'grid' },
  { href: '/produk/mug/', label: 'Mug', icon: 'mug' },
  { href: '/produk/tumbler/', label: 'Tumbler', icon: 'bottle' },
  { href: '/#cara-pesan', label: 'Cara Pesan', icon: 'steps' },
];
const current = Astro.url.pathname;
---

<aside class="rail">
  <a href="/" class="rail__logo" aria-label="Papinka Galeria - Beranda">P</a>
  <nav aria-label="Navigasi utama" class="rail__nav">
    {
      nav.map((item) => (
        <a
          href={item.href}
          title={item.label}
          aria-current={current === item.href ? 'page' : undefined}
          class="rail__item"
        >
          <Icon name={item.icon} />
          <span class="rail__label">{item.label}</span>
        </a>
      ))
    }
  </nav>
  <a href={whatsappLink()} class="rail__wa" target="_blank" rel="noopener" title="Chat WhatsApp">
    <WhatsAppIcon size={20} />
    <span class="sr-only">Chat WhatsApp</span>
  </a>
</aside>

<style>
  .rail {
    position: sticky;
    top: 0;
    height: 100vh;
    width: var(--rail-w);
    background: var(--bg-rail);
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 24px 0;
    z-index: 40;
  }

  .rail__logo {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.3rem;
    text-decoration: none;
  }

  .rail__nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
  }

  .rail__item {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    color: var(--muted);
    text-decoration: none;
  }

  .rail__item:hover {
    color: var(--text);
    background: var(--surface);
  }

  .rail__item[aria-current='page'] {
    color: var(--accent);
    background: var(--surface);
  }

  .rail__label {
    position: absolute;
    left: calc(100% + 10px);
    padding: 4px 10px;
    border-radius: 8px;
    background: var(--surface-2);
    color: var(--text);
    font-size: 0.8rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s;
  }

  .rail__item:hover .rail__label,
  .rail__item:focus-visible .rail__label {
    opacity: 1;
  }

  .rail__wa {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
  }

  .rail__wa:hover {
    background: var(--wa);
  }

  /* Di HP: sidebar menjadi tab bar di bawah layar */
  @media (max-width: 760px) {
    .rail {
      position: fixed;
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      width: auto;
      height: auto;
      flex-direction: row;
      padding: 6px 8px calc(6px + env(safe-area-inset-bottom));
      border-right: 0;
      border-top: 1px solid var(--line);
    }

    .rail__logo,
    .rail__wa {
      display: none;
    }

    .rail__nav {
      flex-direction: row;
      justify-content: space-around;
      gap: 0;
    }

    .rail__item {
      width: auto;
      height: auto;
      padding: 6px 8px;
      gap: 2px;
    }

    .rail__item:hover,
    .rail__item[aria-current='page'] {
      background: transparent;
    }

    .rail__label {
      position: static;
      opacity: 1;
      padding: 0;
      background: none;
      color: inherit;
      font-size: 0.68rem;
    }
  }
</style>
