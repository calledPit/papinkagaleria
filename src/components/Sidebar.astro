---
import { Image } from 'astro:assets';
import Icon, { type IconName } from './Icon.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import LangSwitch from './LangSwitch.astro';
import logoMark from '../assets/logo-mark.png';
import { site } from '../config/site';
import { getLocale, paths, t } from '../i18n';
import { whatsappLink } from '../lib/products';

interface Props {
  switchHref: string;
}

const { switchHref } = Astro.props;
const locale = getLocale(Astro.url);
const ui = t(locale);
const nav: { href: string; label: string; icon: IconName }[] = [
  { href: paths.home(locale), label: ui.home, icon: 'home' },
  { href: paths.catalog(locale), label: ui.catalog, icon: 'grid' },
  { href: paths.howTo(locale), label: ui.howTo, icon: 'steps' },
  { href: paths.blog(locale), label: ui.blog, icon: 'book' },
];
const current = Astro.url.pathname;
---

<aside class="rail">
  <a href={paths.home(locale)} class="rail__logo" aria-label={`${site.name} - ${ui.home}`}>
    <Image src={logoMark} alt="" width={88} height={88} loading="eager" />
  </a>
  <nav aria-label={ui.navMain} class="rail__nav">
    {
      nav.map((item) => (
        <a
          href={item.href}
          title={item.label}
          aria-current={current === item.href || (item.icon === 'book' && current.startsWith(item.href)) ? 'page' : undefined}
          class="rail__item"
        >
          <Icon name={item.icon} />
          <span class="rail__label">{item.label}</span>
        </a>
      ))
    }
  </nav>
  <div class="rail__social">
    <LangSwitch href={switchHref} vertical />
    <a href={site.social.instagram} class="rail__wa" target="_blank" rel="noopener" title={`Instagram ${site.social.instagramHandle}`}>
      <Icon name="instagram" />
      <span class="sr-only">Instagram</span>
    </a>
    <a href={whatsappLink(locale)} class="rail__wa" target="_blank" rel="noopener" title={ui.chat}>
      <WhatsAppIcon size={20} />
      <span class="sr-only">{ui.chat}</span>
    </a>
  </div>
</aside>

<style>
  .rail {
    position: sticky;
    top: 0;
    height: 100vh;
    width: var(--rail-w);
    background: var(--bg-rail);
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 24px 0;
    z-index: 40;
  }

  .rail__logo {
    display: block;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    overflow: hidden;
  }

  .rail__social {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .rail__nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
  }

  .rail__item {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    color: var(--muted);
    text-decoration: none;
  }

  .rail__item:hover {
    color: var(--text);
    background: var(--surface);
  }

  .rail__item[aria-current='page'] {
    color: var(--accent);
    background: var(--surface);
  }

  .rail__label {
    position: absolute;
    left: calc(100% + 10px);
    padding: 4px 10px;
    border-radius: 8px;
    background: var(--surface-2);
    color: var(--text);
    font-size: 0.8rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s;
  }

  .rail__item:hover .rail__label,
  .rail__item:focus-visible .rail__label {
    opacity: 1;
  }

  .rail__wa {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
  }

  .rail__wa:hover {
    background: var(--wa);
  }

  /* Di HP: sidebar menjadi tab bar di bawah layar */
  @media (max-width: 760px) {
    .rail {
      position: fixed;
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      width: auto;
      height: auto;
      flex-direction: row;
      padding: 6px 8px calc(6px + env(safe-area-inset-bottom));
      border-right: 0;
      border-top: 1px solid var(--line);
    }

    .rail__logo,
    .rail__social {
      display: none;
    }

    .rail__nav {
      flex-direction: row;
      justify-content: space-around;
      gap: 0;
    }

    .rail__item {
      width: auto;
      height: auto;
      padding: 6px 8px;
      gap: 2px;
    }

    .rail__item:hover,
    .rail__item[aria-current='page'] {
      background: transparent;
    }

    .rail__label {
      position: static;
      opacity: 1;
      padding: 0;
      background: none;
      color: inherit;
      font-size: 0.68rem;
    }
  }
</style>
