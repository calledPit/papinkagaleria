---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import LangSwitch from './LangSwitch.astro';
import logoMark from '../assets/logo-mark.png';
import { site } from '../config/site';
import { getLocale, paths, t } from '../i18n';
import { whatsappLink } from '../lib/products';

interface Props {
  switchHref: string;
}

const { switchHref } = Astro.props;
const locale = getLocale(Astro.url);
---

<header class="topbar">
  <a href={paths.home(locale)} class="brand">
    <Image src={logoMark} alt="" width={64} height={64} class="brand__mark" loading="eager" />
    Papinka <span>Galeria</span>
  </a>
  <div class="topbar__actions">
    <LangSwitch href={switchHref} />
    <a href={site.social.instagram} class="icon-btn topbar__btn" target="_blank" rel="noopener" aria-label="Instagram">
      <Icon name="instagram" size={16} />
    </a>
    <a href={whatsappLink(locale)} class="icon-btn topbar__btn" target="_blank" rel="noopener" aria-label={t(locale).chat}>
      <WhatsAppIcon size={16} />
    </a>
  </div>
</header>

<style>
  /* Hanya tampil di HP (lihat --topbar-h di global.css) */
  .topbar {
    display: none;
  }

  @media (max-width: 760px) {
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: var(--topbar-h);
      padding: 0 var(--gutter);
    }
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .brand__mark {
    width: 32px;
    height: 32px;
    border-radius: 8px;
  }

  .brand span {
    color: var(--muted);
    font-weight: 400;
  }

  .topbar__actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .topbar__btn {
    width: 36px;
    height: 36px;
    background: var(--surface);
  }
</style>
