---
import type { GetStaticPaths } from 'astro';
import { Image, getImage } from 'astro:assets';
import { getCollection, getEntries, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductCard from '../components/ProductCard.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { site } from '../config/site';
import { paths, t } from '../i18n';
import { whatsappLink } from '../lib/products';

// Halaman area layanan (SEO lokal), hanya bahasa Indonesia.
export const getStaticPaths = (async () =>
  (await getCollection('area')).map((page) => ({ params: { area: page.data.slug }, props: { page } }))) satisfies GetStaticPaths;

const { page } = Astro.props as { page: CollectionEntry<'area'> };
const ui = t('id');
const { title, description, headline, cover, coverAlt, area, areaType } = page.data;
const { Content } = await render(page);
const products = await getEntries(page.data.products);
const others = (await getCollection('area'))
  .filter((p) => p.id !== page.id)
  .sort((a, b) => a.data.order - b.data.order);
const ogImage = await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const url = new URL(`/${page.data.slug}/`, site.url).href;

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: title,
  description,
  url,
  serviceType: 'Souvenir dan merchandise custom',
  areaServed: { '@type': areaType, name: area },
  provider: { '@id': `${site.url}/#organization` },
};
---

<Base title={title} description={description} image={ogImage.src} jsonLd={service} alternates={{ id: `/${page.data.slug}/` }}>
  <section class="section">
    <div class="container area">
      <Breadcrumbs items={[{ label: `Souvenir ${area}`, href: `/${page.data.slug}/` }]} />
      <h1 class="display">
        <span class="line">{headline[0]}</span>
        <span class="line"><span class="hl">{headline[1]}</span></span>
      </h1>
      <p class="lead">{description}</p>

      <div class="area__cover">
        <Image src={cover} alt={coverAlt} width={1200} height={630} fit="cover" loading="eager" />
      </div>

      <div class="prose">
        <Content />
      </div>

      {
        products.length > 0 && (
          <section class="area__products" aria-labelledby="produk-area">
            <div class="section-head">
              <h2 id="produk-area">Produk populer di {area}</h2>
              <a href={paths.catalog('id')} class="text-link">
                {ui.viewAll}
              </a>
            </div>
            <div class="product-grid">
              {products.map((p) => (
                <ProductCard product={p} />
              ))}
            </div>
          </section>
        )
      }

      <aside class="area__cta">
        <h2>Pesan souvenir custom di {area}</h2>
        <p>{ui.articleCtaText}</p>
        <a href={whatsappLink('id', `Halo Papinka Galeria, saya dari ${area} dan ingin pesan souvenir custom.`)} class="btn btn--accent" target="_blank" rel="noopener">
          <WhatsAppIcon size={16} />
          {ui.orderLabel}
        </a>
      </aside>

      <nav class="area__others" aria-label="Area layanan lainnya">
        <span>Area layanan lainnya:</span>
        {others.map((o) => <a href={`/${o.data.slug}/`}>Souvenir custom {o.data.area}</a>)}
      </nav>
    </div>
  </section>
</Base>

<style>
  .area .lead {
    max-width: 62ch;
  }

  .area__cover {
    margin: 2rem 0;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 1200 / 630;
    max-width: 960px;
  }

  .area__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .area__products {
    margin-top: 3rem;
  }

  .area__products h2,
  .area__cta h2 {
    font-size: 1.2rem;
    text-transform: none;
  }

  .area__cta {
    margin: 3rem 0 2rem;
    padding: clamp(24px, 4vw, 36px);
    border-radius: var(--radius);
    background: var(--surface);
    max-width: 820px;
  }

  .area__cta p {
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

  .area__others {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .area__others a {
    color: var(--accent);
  }
</style>
