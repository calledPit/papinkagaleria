---
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductCard from '../../../components/ProductCard.astro';
import ProductPanel from '../../../components/ProductPanel.astro';
import { categories, site } from '../../../config/site';
import { formatCapacity, formatPrice, getProducts, productPath, type Product } from '../../../lib/products';

export const getStaticPaths = (async () => {
  const products = await getProducts();
  return products.map((product) => ({
    params: { category: product.data.category, slug: product.id },
    props: { product, related: products.filter((p) => p.data.category === product.data.category && p.id !== product.id) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  product: Product;
  related: Product[];
}

const { product, related } = Astro.props;
const { code, name, category, capacityMl, price, badges, image } = product.data;
const { Content } = await render(product);
const info = categories[category];

const capacityText = capacityMl ? ` ${capacityMl}ml` : '';
const title = `${name}${capacityText} (${code})`;
const fullDescription = `${name}${capacityText} dari Papinka Galeria, harga ${formatPrice(price)}. ${product.body?.trim() ?? ''}`;
const description =
  fullDescription.length <= 160 ? fullDescription : `${fullDescription.slice(0, 157).replace(/\s+\S*$/, '')}...`;

const ogImage = await getImage({ src: image, width: 1200, height: 1200, fit: 'cover', format: 'jpg' });
const url = new URL(productPath(product), site.url).href;

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${code} ${name}`,
  sku: product.id,
  image: new URL(ogImage.src, site.url).href,
  description: product.body?.trim(),
  category: info.title,
  brand: { '@type': 'Brand', name: site.name },
  offers: {
    '@type': 'Offer',
    url,
    priceCurrency: 'IDR',
    price,
    seller: { '@type': 'Organization', name: site.name },
  },
};
---

<Base title={title} description={description} image={ogImage.src} jsonLd={productSchema}>
  <section class="detail">
    <div class="detail__main">
      <Breadcrumbs
        items={[
          { label: 'Produk', href: '/produk/' },
          { label: info.label, href: `/produk/${category}/` },
          { label: code, href: productPath(product) },
        ]}
      />

      <p class="eyebrow">{code}</p>
      <h1 class="display">{name}</h1>
      <p class="detail__price">{formatPrice(price)}</p>

      <div class="detail__desc">
        <Content />
      </div>

      <dl class="specs">
        <div>
          <dt>Kategori</dt>
          <dd><a href={`/produk/${category}/`}>{info.label}</a></dd>
        </div>
        <div>
          <dt>Kapasitas</dt>
          <dd>{formatCapacity(capacityMl)}</dd>
        </div>
        {
          badges.length > 0 && (
            <div>
              <dt>Termasuk</dt>
              <dd>{badges.join(', ')}</dd>
            </div>
          )
        }
      </dl>
      <p class="detail__note">{site.customNote}</p>

      {
        related.length > 0 && (
          <div class="related">
            <div class="section-head">
              <h2>{info.label} lainnya</h2>
              <a href={`/produk/${category}/`} class="text-link">
                Lihat semua →
              </a>
            </div>
            <div class="related__row">
              {related.map((p) => (
                <ProductCard product={p} />
              ))}
            </div>
          </div>
        )
      }
    </div>

    <ProductPanel product={product} titleTag="p" showDescription={false} closeHref={`/produk/${category}/`} />
  </section>
</Base>

<style>
  .detail {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(360px, 34vw, 460px);
    min-height: calc(100vh - var(--topbar-h));
  }

  .detail__main {
    padding: clamp(28px, 5vw, 56px) var(--gutter) 48px;
    min-width: 0;
  }

  .detail .display {
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    max-width: 16ch;
  }

  .detail__price {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 900;
    color: var(--accent);
  }

  .detail__desc {
    max-width: 60ch;
    color: var(--muted);
  }

  .specs {
    max-width: 520px;
    margin: 1.5rem 0;
  }

  .specs div {
    display: grid;
    grid-template-columns: 130px 1fr;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }

  .specs dt {
    color: var(--muted);
  }

  .specs dd {
    margin: 0;
    font-weight: 700;
  }

  .detail__note {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .related {
    margin-top: clamp(32px, 5vw, 56px);
  }

  .related h2 {
    font-size: 1.4rem;
  }

  .related__row {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 12px;
    scrollbar-width: thin;
    scrollbar-color: var(--surface-2) transparent;
  }

  .related__row > :global(.card) {
    flex: 0 0 200px;
  }

  @media (max-width: 1099px) {
    .detail {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .detail > :global(.panel) {
      order: -1;
    }
  }
</style>
