---
import { Image, getImage } from 'astro:assets';
import { getEntries, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductCard from '../components/ProductCard.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { site } from '../config/site';
import { localeMeta, paths, t } from '../i18n';
import { formatDate, postAlternates, postPath, type Post } from '../lib/blog';
import { whatsappLink } from '../lib/products';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const locale = post.data.lang;
const ui = t(locale);
const { title, description, date, updated, cover, coverAlt } = post.data;
const { Content } = await render(post);
const products = await getEntries(post.data.products);
const alternates = await postAlternates(post);
const ogImage = await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const url = new URL(postPath(post), site.url).href;

const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: new URL(ogImage.src, site.url).href,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  inLanguage: localeMeta[locale].htmlLang,
  mainEntityOfPage: url,
  author: { '@id': `${site.url}/#organization` },
  publisher: { '@id': `${site.url}/#organization` },
};
---

<Base title={title} description={description} image={ogImage.src} jsonLd={article} alternates={alternates}>
  <article class="section">
    <div class="container article">
      <Breadcrumbs
        items={[
          { label: ui.blog, href: paths.blog(locale) },
          { label: title, href: postPath(post) },
        ]}
      />

      <header class="article__head">
        <time datetime={date.toISOString()}>{formatDate(date, locale)}</time>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
      </header>

      <div class="article__cover">
        <Image src={cover} alt={coverAlt} width={1200} height={630} fit="cover" loading="eager" />
      </div>

      <div class="prose">
        <Content />
      </div>

      {
        products.length > 0 && (
          <section class="article__products" aria-labelledby="produk-artikel">
            <h2 id="produk-artikel">{ui.relatedProducts}</h2>
            <div class="article__row">
              {products.map((p) => (
                <ProductCard product={p} />
              ))}
            </div>
          </section>
        )
      }

      <aside class="article__cta">
        <h2>{ui.articleCtaTitle}</h2>
        <p>{ui.articleCtaText}</p>
        <a href={whatsappLink(locale)} class="btn btn--accent" target="_blank" rel="noopener">
          <WhatsAppIcon size={16} />
          {ui.orderLabel}
        </a>
      </aside>

      <a href={paths.blog(locale)} class="text-link">{ui.backToBlog}</a>
    </div>
  </article>
</Base>

<style>
  .article {
    max-width: 820px;
  }

  .article__head time {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .article__head h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 0.4rem 0 1rem;
  }

  .article__cover {
    margin: 2rem 0;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 1200 / 630;
  }

  .article__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article__products {
    margin-top: 3rem;
  }

  .article__products h2,
  .article__cta h2 {
    font-size: 1.15rem;
  }

  .article__row {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding-bottom: 12px;
    scrollbar-width: thin;
    scrollbar-color: var(--surface-2) transparent;
  }

  .article__row > :global(.card) {
    flex: 0 0 200px;
  }

  .article__cta {
    margin: 2.5rem 0 2rem;
    padding: clamp(24px, 4vw, 36px);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .article__cta h2 {
    text-transform: none;
  }

  .article__cta p {
    color: var(--muted);
    margin-bottom: 1.25rem;
  }

</style>
