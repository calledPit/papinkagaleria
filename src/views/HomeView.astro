---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductPanel from '../components/ProductPanel.astro';
import { categoryKeys, site } from '../config/site';
import { getLocale, localeMeta, locales, paths, t } from '../i18n';
import { getProducts, panelData } from '../lib/products';

const locale = getLocale(Astro.url);
const ui = t(locale);
const all = await getProducts();

// Beranda menampilkan 2 produk pertama dari tiap kategori; selengkapnya di katalog.
const products = categoryKeys.flatMap((c) => all.filter((p) => p.data.category === c).slice(0, 2));
const panelItems = await Promise.all(products.map((p) => panelData(p, locale)));

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: new URL(paths.home(locale), site.url).href,
  inLanguage: localeMeta[locale].htmlLang,
  publisher: { '@id': `${site.url}/#organization` },
};
const alternates = Object.fromEntries(locales.map((l) => [l, paths.home(l)]));
---

<Base jsonLd={website} alternates={alternates}>
  <section class="hero">
    <div class="hero__main">
      <h1 class="display">
        <span class="line">{ui.homeLines[0]}</span>
        <span class="line"><span class="hl">{ui.homeLines[1]}</span></span>
        <span class="line">{ui.homeLines[2]}</span>
      </h1>

      <div class="row" data-row>
        {products.map((p, i) => <ProductCard product={p} index={i} active={i === 0} />)}
      </div>

      <div class="hero__about">
        <p class="hero__tag">{ui.homeTag}</p>
        <p class="hero__text">{ui.homeText}</p>
        <a href={paths.catalog(locale)} class="btn btn--accent">{ui.viewCatalog}</a>
      </div>
    </div>

    <ProductPanel product={products[0]} interactive />
  </section>

  <script type="application/json" id="panel-data" set:html={JSON.stringify(panelItems)} />
</Base>

<script>
  import type { PanelData } from '../lib/products';

  const dataEl = document.getElementById('panel-data');
  const panel = document.querySelector<HTMLElement>('[data-panel]');
  const row = document.querySelector<HTMLElement>('[data-row]');

  if (dataEl && panel && row) {
    const items: PanelData[] = JSON.parse(dataEl.textContent ?? '[]');
    const cards = [...row.querySelectorAll<HTMLElement>('[data-card]')];
    const field = <T extends HTMLElement>(key: string) => panel.querySelector<T>(`[data-p="${key}"]`)!;
    // Di layar lebar panel tampil di samping kartu, jadi klik kartu cukup mengganti isi panel.
    const sideBySide = window.matchMedia('(min-width: 1100px)');
    let current = 0;

    const show = (index: number) => {
      current = (index + items.length) % items.length;
      const d = items[current];
      const img = field<HTMLImageElement>('img');
      img.src = d.img;
      img.alt = d.alt;
      field('name').textContent = d.name;
      field('code').textContent = `(${d.code})`;
      field('size').textContent = d.size;
      field('feature').textContent = d.feature;
      field('category').textContent = d.category;
      field('desc').textContent = d.desc;
      field<HTMLAnchorElement>('url').href = d.url;
      field<HTMLAnchorElement>('wa').href = d.wa;
      field('price').textContent = d.price;
      field('price').classList.toggle('price-ask', !d.hasPrice);

      cards.forEach((card, i) => card.classList.toggle('is-active', i === current));
      row.scrollTo({ left: cards[current].offsetLeft - 4, behavior: 'smooth' });
    };

    cards.forEach((card, i) =>
      card.addEventListener('click', (event) => {
        if (!sideBySide.matches || (event.target as Element).closest('.card__wa')) return;
        event.preventDefault();
        show(i);
      }),
    );
    field('prev').addEventListener('click', () => show(current - 1));
    field('next').addEventListener('click', () => show(current + 1));
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(400px, 38vw, 680px);
    min-height: calc(100vh - var(--topbar-h));
  }

  .hero__main {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(28px, 5vw, 56px) var(--gutter);
  }

  .row {
    position: relative;
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 4px 4px 12px;
    margin: clamp(20px, 3.5vw, 40px) -4px 0;
    scrollbar-width: thin;
    scrollbar-color: var(--surface-2) transparent;
  }

  .row > :global(.card) {
    flex: 0 0 clamp(170px, 16vw, 210px);
    scroll-snap-align: start;
  }

  .hero__about {
    position: relative;
    z-index: 1;
    margin-top: clamp(20px, 3.5vw, 40px);
    max-width: 460px;
  }

  .hero__tag {
    font-weight: 500;
    font-size: 1rem;
    margin-bottom: 0.4rem;
  }

  .hero__text {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 1099px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }
  }
</style>
